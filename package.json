{
  "name": "bigfloat",
  "version": "1.4.9",
  "description": "高精度BigFloatライブラリ。複素数や行列もサポート",
  "license": "Apache-2.0",
  "author": "hi2ma-bu4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi2ma-bu4/BigFloat.git"
  },
  "homepage": "https://github.com/hi2ma-bu4/BigFloat",
  "bugs": {
    "url": "https://github.com/hi2ma-bu4/BigFloat/issues"
  },
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "node ./dev/build.mjs",
    "build:md": "node ./dev/build-md.mjs",
    "test:unit": "tsx --test --test-concurrency=1 \"test/node/**/*.test.ts\"",
    "test": "npm run build && npm run test:unit"
  },
  "exports": {
    ".": {
      "import": "./dist/BigFloat.js",
      "types": "./dist/BigFloat.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^25.5.0",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.27.4",
    "ts-morph": "^27.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "volta": {
    "node": "24.14.0",
    "npm": "11.11.1"
  }
}
